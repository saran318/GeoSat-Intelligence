# ── Backend Runtime (Render / Local FastAPI) ─────────────────────────────────
ENV=development
ENABLE_API_DOCS=true
HOST=0.0.0.0
PORT=8000
# Comma-separated frontend origins allowed by CORS (never use * with credentials)
ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app,http://localhost:5173

# ── Security & Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=1048576
MAX_URL_LENGTH=2048

# ── Supabase (Structured Analytics) ──────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Backend/seeding key (service_role preferred for seeding; anon/service key for API)
SUPABASE_KEY=your-supabase-key
# Optional explicit overrides (checked in order: SERVICE_ROLE_KEY -> KEY -> ANON_KEY)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Backblaze B2 (GeoTIFFs, Previews, Visual Assets) ─────────────────────────
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=geosat-assets
# Application Key ID and Application Key from Backblaze B2 (required for private bucket access)
B2_ACCESS_KEY_ID=your-b2-key-id
B2_SECRET_ACCESS_KEY=your-b2-application-key
