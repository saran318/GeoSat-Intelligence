# Production FastAPI backend URL (set in Vercel Environment Variables)
# Example: https://geosat-intelligence-api.onrender.com/api
# Leave unset locally to use Vite's /api dev proxy
VITE_API_BASE_URL=https://your-render-backend.onrender.com/api

# Datadog Real User Monitoring (RUM) - Browser-safe client config (never put Datadog API keys here)
VITE_DD_APPLICATION_ID=your-datadog-rum-application-id
VITE_DD_CLIENT_TOKEN=your-datadog-rum-client-token
VITE_DD_SITE=us5.datadoghq.com
VITE_DD_REMOTE_CONFIG_ID=your-datadog-remote-config-id
VITE_DD_SERVICE=geosat-intelligence-frontend
VITE_DD_ENV=production
VITE_DD_VERSION=1.0.0
# Optional: set to "true" to enable RUM during local `npm run dev`
VITE_DD_ENABLE_DEV=false
